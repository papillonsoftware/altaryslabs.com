#!/bin/bash
# ALTARYS LABS - altaryslabs.com
# Reviewer INTERACTIF (session fraiche ; le fondateur reste dans la boucle).
#
# La procedure de revue stable (suivre .claude/commands/review.md, forker un worktree
# depuis la branche de l'item, etapes obligatoires, commentaire de PR) est portee par
# --append-system-prompt depuis .claude/reviewer-append.txt, partage avec
# bin/autonomous_reviewer. L'appel ne passe donc que "<ID> (PR #<num>)".
#
# Usage : bin/reviewer "<ID> (PR #<num>)"      (depuis la racine du depot)
#   ex. : bin/reviewer "PAGE-004 (PR #17)"
#
# Le reviewer ne fusionne jamais et ne modifie jamais la source.
set -euo pipefail
cd "$(dirname "$0")/.."
claude --system-prompt-file .claude/personalities/REVIEWER.md \
       --append-system-prompt "$(cat .claude/reviewer-append.txt)" \
       --model opus "$@"
