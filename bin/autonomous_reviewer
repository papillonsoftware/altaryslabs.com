#!/bin/bash
# ALTARYS LABS - altaryslabs.com
# Reviewer AUTONOME (tache de fond, sans surveillance). Meme personnalite REVIEWER.md
# que bin/reviewer, avec trois differences :
#  (1) l'autonomie (aucun plan gate) est ajoutee au system prompt via --append-system-prompt ;
#  (2) les permissions sont accordees par une allowlist CIBLEE
#      (.claude/autonomous-reviewer-settings.json) plutot que par
#      --dangerously-skip-permissions ;
#  (3) -p rend l'execution non interactive (headless).
#
# La procedure de revue stable est portee par .claude/reviewer-append.txt, partage
# avec bin/reviewer.
#
# L'autonomie porte sur la REVUE, jamais sur une decision du fondateur : le reviewer
# ne fusionne pas, ne modifie pas la source, et s'arrete sur toute question de
# direction editoriale ou commerciale.
#
# Usage : bin/autonomous_reviewer "<ID> (PR #<num>)"      (depuis la racine du depot)
#   ex. : bin/autonomous_reviewer "PAGE-004 (PR #17)"
set -euo pipefail
# Racine du checkout, resolue en absolu pour pouvoir sourcer bin/lib apres le cd.
RACINE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$RACINE"

# Refuse de demarrer si cet arbre est en retard sur origin/refonte-multipages :
# les instructions du relecteur seraient perimees. Voir bin/lib/fraicheur.sh.
# Critique ici : une ronde autonome tourne en -p, donc sans personne pour
# remarquer que le relecteur applique des regles annulees.
. "$RACINE/bin/lib/fraicheur.sh"
verifier_fraicheur

AUTONOMY='AUTONOMOUS MODE: you run headless in the background, pre-authorized by the founder. Do NOT present a plan or ask "may I proceed" - execute the review end to end on your own. Write the review file directly with Write/Edit (do not delegate to a subagent). STOP only for a genuine editorial or commercial decision that only the founder can make. You still never modify source files and never merge.'
claude --system-prompt-file .claude/personalities/REVIEWER.md \
       --append-system-prompt "$(cat .claude/reviewer-append.txt)

$AUTONOMY" \
       --settings .claude/autonomous-reviewer-settings.json \
       --model opus -p "$@"
