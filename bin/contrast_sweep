#!/usr/bin/env node
// ALTARYS LABS - altaryslabs.com
// Balayage de contraste WCAG AA, fondation claire REVEILLEE.
//
// Injecte `.section--light` sur chaque <section> d'une page, puis mesure chaque
// element porteur de texte contre son fond effectif, en remontant les ancetres
// jusqu'au premier fond opaque et en composant les couleurs semi-transparentes.
// Seuils : 4.5:1, ou 3:1 pour le grand texte au sens de SC 1.4.3.
//
// Pourquoi cet outil existe. Trois rondes de revue consecutives ont trouve des
// classes de composants restees sur des jetons de surface sombre, parce que je
// les cherchais a la lecture. Une fondation qui pretend couvrir des classes
// qu'elle ne couvre pas est pire qu'une fondation qui ne pretend rien : le trou
// est ferme dans le journal et ouvert dans le code. Cet outil mesure au lieu
// d'enumerer. Voir D048.
//
// Usage : bin/contrast_sweep <base-url> <chemin> [<chemin>...]
//   ex. : bin/contrast_sweep http://localhost:4321 / /a-propos /mentions-legales
//
// Pour balayer tout le site depuis un `npm run preview` :
//   PAGES=$(cd dist && find . -name index.html | sed 's|^\.||; s|/index.html$||; s|^$|/|')
//   bin/contrast_sweep http://localhost:4321 $PAGES
import { spawn } from 'node:child_process';

const [, , base, ...paths] = process.argv;
const CHROME = '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';
const port = 9500 + (process.pid % 400);

const chrome = spawn(CHROME, ['--headless=new', '--disable-gpu',
  `--remote-debugging-port=${port}`, `--user-data-dir=/tmp/sweep-${process.pid}`], { stdio: 'ignore' });

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
for (let i = 0; i < 60; i++) { try { await fetch(`http://127.0.0.1:${port}/json/version`); break; } catch { await sleep(250); } }

const tab = await (await fetch(`http://127.0.0.1:${port}/json/new?about:blank`, { method: 'PUT' })).json();
const ws = new WebSocket(tab.webSocketDebuggerUrl);
let id = 0; const pending = new Map();
ws.addEventListener('message', (e) => { const m = JSON.parse(e.data); if (m.id && pending.has(m.id)) { pending.get(m.id)(m.result); pending.delete(m.id); } });
await new Promise((r) => ws.addEventListener('open', r));
const send = (method, params = {}) => new Promise((res) => { const n = ++id; pending.set(n, res); ws.send(JSON.stringify({ id: n, method, params })); });
await send('Page.enable');

const EXPR = `(() => {
  document.querySelectorAll('section').forEach(s => s.classList.add('section--light'));
  const lum = (c) => { const [r,g,b] = c; const f = v => { v/=255; return v<=0.03928 ? v/12.92 : Math.pow((v+0.055)/1.055,2.4); };
    return 0.2126*f(r)+0.7152*f(g)+0.0722*f(b); };
  const parse = (s) => { const m = s.match(/rgba?\\(([^)]+)\\)/); if(!m) return null;
    const p = m[1].split(',').map(Number); return {c:[p[0],p[1],p[2]], a: p.length>3?p[3]:1}; };
  const bgOf = (el) => { let n = el;
    while (n) { const b = parse(getComputedStyle(n).backgroundColor); if (b && b.a > 0.5) return b.c; n = n.parentElement; }
    return [246,242,233]; };
  const out = [];
  for (const el of document.querySelectorAll('*')) {
    if (!el.childNodes.length) continue;
    const hasText = [...el.childNodes].some(n => n.nodeType === 3 && n.textContent.trim());
    if (!hasText) continue;
    const st = getComputedStyle(el);
    const fg = parse(st.color); if (!fg) continue;
    const bg = bgOf(el);
    const mix = fg.a < 1 ? fg.c.map((v,i) => v*fg.a + bg[i]*(1-fg.a)) : fg.c;
    const l1 = lum(mix), l2 = lum(bg);
    const ratio = (Math.max(l1,l2)+0.05)/(Math.min(l1,l2)+0.05);
    const size = parseFloat(st.fontSize);
    const large = size >= 24 || (size >= 18.66 && parseInt(st.fontWeight) >= 700);
    const need = large ? 3 : 4.5;
    if (ratio < need) out.push({ cls: (el.className && el.className.baseVal === undefined ? el.className : '') || el.tagName,
      ratio: +ratio.toFixed(2), need, size });
  }
  const seen = new Map();
  for (const o of out) { const k = o.cls.split(' ')[0] + '|' + o.ratio; if (!seen.has(k)) seen.set(k, o); }
  return JSON.stringify([...seen.values()]);
})()`;

let total = 0;
for (const p of paths) {
  await send('Page.navigate', { url: base + p });
  await sleep(900);
  const r = await send('Runtime.evaluate', { expression: EXPR, returnByValue: true });
  const fails = JSON.parse(r.result.value || '[]');
  if (fails.length) { total += fails.length; console.log(`\n${p}`); fails.forEach(f => console.log(`  ${f.ratio}:1 (min ${f.need})  ${f.size}px  ${f.cls}`)); }
}
console.log(total === 0 ? '\nAUCUN ECHEC AA, fondation reveillee' : `\n${total} echecs`);
ws.close(); chrome.kill(); process.exit(0);
