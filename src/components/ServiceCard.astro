---
/**
 * Carte service. Volontairement plus effacee que la carte produit : fond plus
 * sombre, bordure neutre, pas de badge. La hierarchie visuelle du design fait
 * primer les produits, les services les accompagnent.
 */
interface Props {
  name: string;
  text: string;
  href: string;
  linkLabel: string;
}

const { name, text, href, linkLabel } = Astro.props;
---

<article class="card card--service">
  <h3 class="card-title">{name}</h3>
  <p class="card-text">{text}</p>
  <a class="link-arrow" href={href}>
    {linkLabel}
    <span class="visually-hidden">: {name}</span>
  </a>
</article>

<style>
  .card {
    transition: border-color var(--ease), transform var(--ease);
  }

  .card:hover {
    border-color: var(--ink-15);
    transform: translateY(-2px);
  }
</style>
