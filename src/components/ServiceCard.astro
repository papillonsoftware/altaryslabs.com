---
/**
 * Carte service.
 *
 * Sur l'accueil elle est volontairement plus effacee que la carte produit : la
 * hierarchie du design y fait primer les produits. Sur son propre hub, ou elle
 * n'a plus a s'effacer devant personne, elle reprend le fond des cartes
 * produits. C'est le parti pris du handoff, et il se tient.
 */
import { LABEL_SEPARATOR, type Locale } from '../i18n/config';

interface Props {
  name: string;
  /**
   * Langue de la page, pour le separateur du nom accessible du lien.
   * Meme raison que dans `ProductCard.astro`, ou elle est expliquee : le nom
   * est un `aria-label` plat parce qu'un nom calcule depuis les descendants se
   * voit inserer une espace a la frontiere des elements en ligne. Voir D133.
   */
  locale: Locale;
  text: string;
  href: string;
  linkLabel: string;
  /** Variante aeree du hub, ou la carte est le contenu principal. */
  large?: boolean;
  headingLevel?: 2 | 3;
}

const { name, locale, text, href, linkLabel, large = false, headingLevel = 3 } = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class:list={['card', large ? 'card--prominent card--large' : 'card--service']}>
  <Heading class="card-title">{name}</Heading>
  <p class="card-text">{text}</p>
  {/* Nom accessible PLAT, et non compose de descendants. Voir D133. */}
  <a class="link-arrow" href={href} aria-label={`${linkLabel}${LABEL_SEPARATOR[locale]}${name}`}>
    {linkLabel}
  </a>
</article>

<style>
  .card {
    transition: border-color var(--ease), transform var(--ease);
  }

  .card:hover {
    border-color: var(--ink-15);
    transform: translateY(-2px);
  }

  /* Fond des cartes produits, mais bordure neutre : l'or reste reserve aux
     produits, meme quand le service occupe le premier plan. */
  .card--prominent {
    background: var(--navy-mid);
    border-color: var(--ink-06);
  }
</style>
