---
/**
 * Carte service.
 *
 * Sur l'accueil elle est volontairement plus effacee que la carte produit : la
 * hierarchie du design y fait primer les produits. Sur son propre hub, ou elle
 * n'a plus a s'effacer devant personne, elle reprend le fond des cartes
 * produits. C'est le parti pris du handoff, et il se tient.
 */
interface Props {
  name: string;
  text: string;
  href: string;
  linkLabel: string;
  /** Variante aeree du hub, ou la carte est le contenu principal. */
  large?: boolean;
  headingLevel?: 2 | 3;
}

const { name, text, href, linkLabel, large = false, headingLevel = 3 } = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class:list={['card', large ? 'card--prominent card--large' : 'card--service']}>
  <Heading class="card-title">{name}</Heading>
  <p class="card-text">{text}</p>
  <a class="link-arrow" href={href}>
    {linkLabel}
    <span class="visually-hidden">: {name}</span>
  </a>
</article>

<style>
  .card {
    transition: border-color var(--ease), transform var(--ease);
  }

  .card:hover {
    border-color: var(--ink-15);
    transform: translateY(-2px);
  }

  /* Fond des cartes produits, mais bordure neutre : l'or reste reserve aux
     produits, meme quand le service occupe le premier plan. */
  .card--prominent {
    background: var(--navy-mid);
    border-color: var(--ink-06);
  }
</style>
