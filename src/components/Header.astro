---
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import type { Locale } from '../i18n/config';
import { localizedPath, useTranslations } from '../i18n/utils';
import { PRODUCT_KEYS, SERVICE_KEYS, type PageKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  pageKey: PageKey;
}

const { locale, pageKey } = Astro.props;
const t = useTranslations(locale);

// Deux menus deroulants simples, pas de mega-menu : chacun liste le hub puis
// ses trois sous-pages. L'ordre Produits avant Services est un choix de
// positionnement, pas un hasard de mise en page.
const menus = [
  { key: 'products' as PageKey, label: t.nav.products, children: PRODUCT_KEYS },
  { key: 'services' as PageKey, label: t.nav.services, children: SERVICE_KEYS },
];

/** Une entree est active si elle est la page courante ou son hub parent. */
const isActive = (key: PageKey, children: readonly PageKey[] = []) =>
  pageKey === key || children.includes(pageKey);
---

<a class="skip-link" href="#main">{t.common.skipToContent}</a>

<header class="nav" id="site-header">
  <div class="nav-inner">
    <a
      class="nav-logo"
      href={localizedPath('home', locale)}
      aria-label={`ALTARYS LABS, ${t.nav.home}`}
    >
      <Logo lockup="stacked" detail="full" surface="light" />
    </a>

    <nav class="nav-primary" id="nav-primary" aria-label={t.nav.products + ' / ' + t.nav.services}>
      <ul class="nav-list">
        {
          menus.map(({ key, label, children }) => (
            <li class="nav-item has-menu">
              <div class="nav-row">
                <a
                  class="nav-link"
                  href={localizedPath(key, locale)}
                  aria-current={pageKey === key ? 'page' : undefined}
                  data-active={isActive(key, children)}
                >
                  {label}
                </a>
                <button
                  type="button"
                  class="nav-disclosure"
                  aria-expanded="false"
                  aria-controls={`menu-${key}`}
                  aria-label={`${label} : ${t.nav.openMenu}`}
                >
                  <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
                    <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </button>
              </div>

              <ul class="nav-menu" id={`menu-${key}`}>
                {children.map((childKey) => (
                  <li>
                    <a
                      href={localizedPath(childKey, locale)}
                      aria-current={pageKey === childKey ? 'page' : undefined}
                    >
                      <span class="nav-menu-name">{t.pageName[childKey]}</span>
                      <span class="nav-menu-tagline">{t.pageTagline[childKey]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }

        <li class="nav-item">
          <a
            class="nav-link"
            href={localizedPath('about', locale)}
            aria-current={pageKey === 'about' ? 'page' : undefined}
            data-active={pageKey === 'about'}>{t.nav.about}</a
          >
        </li>
        <li class="nav-item">
          <a
            class="nav-link"
            href={localizedPath('contact', locale)}
            aria-current={pageKey === 'contact' ? 'page' : undefined}
            data-active={pageKey === 'contact'}>{t.nav.contact}</a
          >
        </li>
      </ul>

      <div class="nav-tail">
        <LangSwitcher locale={locale} pageKey={pageKey} />
        <a class="nav-cta" href={localizedPath('contact', locale)}>{t.nav.cta}</a>
      </div>
    </nav>

    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-primary"
      aria-label={t.nav.openMenu}
      data-label-open={t.nav.openMenu}
      data-label-close={t.nav.closeMenu}
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  /* Header toujours clair, quelle que soit la section defilee derriere lui
     (UI-002, D055) : il ne depend d'aucun `.section--light`, ses couleurs sont
     fixees ici une bonne fois. */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--cream-header-94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--navy-08);
  }

  /* Seul point du header ou le gold standard (2.47:1 sur creme) ne suffit pas :
     --gold-deep est le meme correctif que celui applique par le peritexte
     .section--light, D039, mais le header n'est jamais dans cette classe.
     (D030 porte sur des substitutions de petit texte, aucune a 2.47:1 ; c'est
     D039 qui vise nommement le bouton secondaire et l'anneau de focus, et que
     cite deja le commentaire jumeau de .nav-cta. Corrige en R1.) */
  .nav :focus-visible {
    outline-color: var(--gold-deep);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: var(--nav-h);
  }

  /* `flex` et non `inline-flex` : une ancre en ligne reserve la descendante de
     sa ligne de texte sous le logo, ce qui le decalait de deux pixels vers le
     haut dans un header centre verticalement.

     `text-decoration: none` doit etre pose ici, sur l'ancre, et non sur le
     mot-marque : `global.css` ne fixe que `a { color: inherit }`, donc le
     soulignement par defaut du navigateur s'applique, et une decoration se
     propage depuis l'ancetre sans qu'un descendant puisse l'annuler. Le logo
     etait un SVG pur jusqu'ici, sans texte a souligner : le trait n'est apparu
     qu'en passant le mot-marque en vrai texte.

     `min-height: 44px` restaure la cible tactile : l'ancien verrou rendait un
     SVG de 38px de haut, le nouveau n'en fait que 28. Le header mesurant 72px,
     la contrainte ne deplace rien a l'ecran. */
  .nav-logo {
    display: flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .nav-primary {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 38px;
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-row {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-link {
    font-size: 14.5px;
    font-weight: 400;
    color: var(--slate-nav);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color var(--ease);
  }

  .nav-link:hover,
  .nav-link[data-active='true'] {
    color: var(--gold-deeper);
  }

  .nav-disclosure {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: none;
    border: none;
    color: var(--slate-nav);
    cursor: pointer;
    transition: color var(--ease), transform var(--ease);
  }

  .nav-disclosure:hover {
    color: var(--gold-deep);
  }

  .nav-disclosure[aria-expanded='true'] {
    transform: rotate(180deg);
    color: var(--gold-deep);
  }

  /* --- Menu deroulant, desktop --- */
  .nav-menu {
    display: none;
    position: absolute;
    top: calc(100% + 14px);
    left: -16px;
    min-width: 288px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--navy-10);
    border-radius: var(--radius);
    padding: 8px;
    box-shadow: var(--shadow-menu);
  }

  /* Zone tampon invisible : evite que le menu se ferme en traversant le vide
     entre le libelle et le panneau. */
  .has-menu::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 14px;
  }

  .has-menu:hover .nav-menu,
  .has-menu:focus-within .nav-menu,
  .nav-menu[data-open='true'] {
    display: block;
  }

  .nav-menu a {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--ease);
  }

  .nav-menu a:hover {
    background: var(--gold-06);
  }

  .nav-menu-name {
    display: block;
    font-size: 13.5px;
    color: var(--navy-text);
  }

  .nav-menu a:hover .nav-menu-name,
  .nav-menu a[aria-current='page'] .nav-menu-name {
    color: var(--gold-deeper);
  }

  /* Panneau blanc : --slate-body, deja la couleur de corps de texte standard
     sur clair (5.33:1 sur creme, davantage sur blanc). */
  .nav-menu-tagline {
    display: block;
    margin-top: 2px;
    font-size: 11.5px;
    font-weight: 300;
    color: var(--slate-body);
    line-height: 1.5;
  }

  .nav-tail {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* Le remplissage or seul ne vaut que 2.47:1 sur le fond creme du header,
     sous le seuil de 3:1 de SC 1.4.11 pour la limite d'un composant : meme
     correctif que .btn-primary sous .section--light, D039. */
  .nav-cta {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--navy-deep);
    background: var(--gold);
    border: 1px solid var(--gold-deep);
    padding: 10px 21px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--ease), transform 0.2s ease;
  }

  .nav-cta:hover {
    background: var(--gold-light);
    transform: translateY(-1px);
  }

  /* --- Bouton hamburger --- */
  /* 44x44, comme .nav-disclosure au meme point de rupture, plus bas dans ce
     fichier : la cible rendait 38x42, sous le seuil de 44px pour une cible
     tactile. */
  .nav-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
  }

  /* Pas de marge ici : en layout bloc les marges de 5px se fusionnaient entre
     barres (centres a 7px d'ecart), mais flex ne fusionne jamais les marges
     entre ses enfants, ce qui les ecartait a 12px et desalignait le X ouvert
     (rotate(45deg) translate(5px, 5px), calibre pour 5*racine(2) = 7.07px).
     Le gap: 5px du conteneur reproduit exactement l'ecart d'origine. */
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--navy-text);
    transition: transform var(--ease), opacity var(--ease);
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* --- Mobile : le menu devient un accordeon plein ecran --- */
  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }

    .nav-primary {
      display: none;
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      max-height: calc(100dvh - var(--nav-h));
      overflow-y: auto;
      padding: 20px var(--gutter) 28px;
      background: var(--cream-header);
      border-bottom: 1px solid var(--navy-08);
    }

    .nav-primary[data-open='true'] {
      display: flex;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }

    .nav-row {
      justify-content: space-between;
      padding: 4px 0;
    }

    .nav-link {
      display: block;
      flex: 1;
      padding: 12px 0;
      font-size: 15px;
    }

    .nav-disclosure {
      width: 44px;
      height: 44px;
    }

    .nav-menu {
      position: static;
      min-width: 0;
      margin: 0 0 8px;
      padding: 4px;
      box-shadow: none;
      background: var(--navy-04);
    }

    /* Sur mobile le survol n'existe pas : seul le bouton ouvre le panneau. */
    .has-menu:hover .nav-menu,
    .has-menu:focus-within .nav-menu {
      display: none;
    }

    .nav-menu[data-open='true'] {
      display: block;
    }

    .has-menu::after {
      display: none;
    }

    .nav-tail {
      justify-content: space-between;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid var(--navy-08);
    }
  }

  /* Sans JavaScript, le hamburger ne peut rien ouvrir : on deplie tout. */
  :global(.no-js) .nav-primary {
    display: flex;
  }

  :global(.no-js) .nav-menu {
    display: block;
  }

  :global(.no-js) .nav-disclosure {
    display: none;
  }

  :global(.no-js) .nav-toggle {
    display: none;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const primary = document.getElementById('nav-primary');

  if (header && toggle && primary) {
    const disclosures = Array.from(
      header.querySelectorAll<HTMLButtonElement>('.nav-disclosure')
    );
    const panelOf = (button: HTMLButtonElement) =>
      document.getElementById(button.getAttribute('aria-controls') ?? '');

    const setPanel = (button: HTMLButtonElement, open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      const panel = panelOf(button);
      if (panel) panel.dataset.open = String(open);
    };

    const closeAllPanels = () => disclosures.forEach((b) => setPanel(b, false));

    const setMenu = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      primary.dataset.open = String(open);
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute('aria-label', label);
      if (!open) closeAllPanels();
    };

    toggle.addEventListener('click', () => {
      setMenu(toggle.getAttribute('aria-expanded') !== 'true');
    });

    disclosures.forEach((button) => {
      button.addEventListener('click', () => {
        const willOpen = button.getAttribute('aria-expanded') !== 'true';
        closeAllPanels();
        setPanel(button, willOpen);
      });
    });

    // Fermeture au clic exterieur et a la touche Echap.
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) {
        closeAllPanels();
        setMenu(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeAllPanels();
      if (toggle.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        toggle.focus();
      }
    });
  }
</script>
