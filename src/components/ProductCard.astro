---
/**
 * Carte produit. Utilisee sur l'accueil et sur le hub Produits, avec le meme
 * contenu : une seule source, pas de divergence possible entre les deux pages.
 */
interface Props {
  name: string;
  /** Etiquette courte : disponibilite pour PCS, categorie pour les autres. */
  badge: string;
  /** Badge plein, reserve au produit le plus saillant du moment. */
  badgeSolid?: boolean;
  text: string;
  href: string;
  linkLabel: string;
  /** Variante aeree du hub, ou la carte est le contenu principal. */
  large?: boolean;
  /**
   * Niveau du titre. 3 sur l'accueil, ou un h2 porte deja le titre de section ;
   * 2 sur le hub, ou le h1 est le titre de page.
   */
  headingLevel?: 2 | 3;
}

const {
  name,
  badge,
  badgeSolid = false,
  text,
  href,
  linkLabel,
  large = false,
  headingLevel = 3,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class:list={['card', { 'card--large': large }]}>
  <span class:list={['badge', badgeSolid ? 'badge--solid' : 'badge--soft']}>{badge}</span>
  <Heading class="card-title">{name}</Heading>
  <p class="card-text">{text}</p>
  <a class="link-arrow" href={href}>
    {linkLabel}
    <span class="visually-hidden">: {name}</span>
  </a>
</article>

<style>
  .card {
    transition: border-color var(--ease), transform var(--ease);
  }

  .card:hover {
    border-color: var(--gold-30);
    transform: translateY(-2px);
  }

  .badge {
    margin-bottom: 20px;
  }

  .card--large .badge {
    margin-bottom: 22px;
  }
</style>
