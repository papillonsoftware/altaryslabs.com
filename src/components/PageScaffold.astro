---
/**
 * Ossature provisoire de page (phase 2).
 *
 * Elle porte le titre, l'accroche et le fil d'Ariane definitifs, et reserve la
 * place du contenu editorial qui sera redige en phase 3. Un bandeau explicite
 * signale que la page n'est pas finalisee : rien ici ne doit partir en
 * production tel quel.
 */
import type { Locale } from '../i18n/config';
import { localizedPath, useTranslations } from '../i18n/utils';
import type { PageKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  /** Cle du hub parent, pour le fil d'Ariane. */
  parent?: PageKey;
}

const { locale, pageKey, parent } = Astro.props;
const t = useTranslations(locale);

const crumbs: PageKey[] = parent ? ['home', parent] : ['home'];
const isHome = pageKey === 'home';
---

<section class="section section--deep page-head">
  <div class="container">
    {
      !isHome && (
        <nav class="breadcrumb" aria-label={locale === 'fr' ? "Fil d'Ariane" : 'Breadcrumb'}>
          <ol>
            {crumbs.map((key) => (
              <li>
                <a href={localizedPath(key, locale)}>{t.pageName[key]}</a>
              </li>
            ))}
            <li aria-current="page">{t.pageName[pageKey]}</li>
          </ol>
        </nav>
      )
    }

    <h1 class="page-title">{t.pageName[pageKey]}</h1>

    {t.pageTagline[pageKey] && <p class="lede">{t.pageTagline[pageKey]}</p>}
  </div>
</section>

<section class="section section--navy">
  <div class="container">
    <p class="scaffold-note mono">
      {
        locale === 'fr'
          ? 'Ossature de page. Le contenu editorial est redige en phase 3.'
          : 'Page scaffold. Editorial content is written in phase 3.'
      }
    </p>
    <slot />
  </div>
</section>

<style>
  .page-head {
    padding-top: 88px;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin-bottom: 24px;
  }

  .breadcrumb li {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* Meme correction de contraste que partout ailleurs, bien que ce
       composant soit voue a disparaitre avec les pages Contact. D029. */
    color: var(--ink-60);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--gold-30);
  }

  .breadcrumb a {
    color: var(--ink-60);
    text-decoration: none;
    transition: color var(--ease);
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  /* .page-title est desormais defini dans global.css */

  .scaffold-note {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--gold-light);
    background: var(--gold-10);
    border: 1px dashed var(--gold-30);
    border-radius: var(--radius-sm);
    padding: 10px 16px;
  }
</style>
