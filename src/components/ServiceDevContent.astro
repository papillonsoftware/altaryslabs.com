---
/**
 * Corps de la fiche Developpement sur mesure, partage par les deux langues.
 */
import PageHeader from './PageHeader.astro';
import ApproachCard from './ApproachCard.astro';
import CtaBanner from './CtaBanner.astro';
import type { Locale } from '../i18n/config';
import { localizedPath, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<PageHeader
  label={t.service.label}
  title={t.pageName.servicesDev}
  intro={t.serviceDev.intro}
  align="left"
/>

<ApproachCard
  label={t.serviceDev.approachLabel}
  text={t.serviceDev.approachText}
  tags={t.serviceDev.tags}
/>

<CtaBanner
  title={t.service.ctaTitle}
  label={t.service.ctaLabel}
  href={localizedPath('contact', locale)}
/>
